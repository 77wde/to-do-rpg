# ============================================================================
# QuestLog — environment variables
#
# Copy this file to .env.local and fill in the values, then restart the dev
# server. Until both values are set, the app runs in local-only mode
# (localStorage save, no login, no database).
#
# Dashboard: Project Settings -> API
# ============================================================================

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_).
# Safe to ship to the browser — row access is enforced by RLS.
# NEVER put the service_role / secret key here: NEXT_PUBLIC_ vars are sent
# to every visitor, and that key bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
